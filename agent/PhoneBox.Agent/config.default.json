{
  // PhoneBox settings. Easiest to edit from the tray icon > Settings (http://127.0.0.1:8765).
  // Manual edits are picked up on the next request; no restart needed.

  // Only use the phone with this serial number (null = every connected Android device)
  "deviceSerial": null,
  // Path to adb.exe (null = searched in PATH, the Android SDK and winget locations)
  "adbPath": null,

  // Weather location (Open-Meteo, no API key required)
  "weather": { "city": "Tallinn", "lat": 59.437, "lon": 24.745 },

  // Night mode: between these times the screen dims and only the clock stays. Tap to wake it for 30 s.
  "night": { "enabled": true, "start": "00:30", "end": "07:30", "brightness": 0.02 },

  // Clock seconds, return to the first page after N idle seconds (0 = never), vibrate on session events,
  // switch pages with the phone's volume keys
  "display": { "showSeconds": true, "hour12": false, "idleReturnSec": 90, "vibrate": true, "volumeKeys": true },

  // Pages in the order they appear on the phone. Each page is a 12 x 6 grid of widgets; the settings page has a
  // visual editor. { "template": "<id>" } creates a page from templates.json (home, ai, work, system, procs, deck,
  // music, clock, focus, world, dashboard, devops, feeds, ambient, markets, daily, status, calm) and is replaced by
  // its widgets on the first save.
  "pages": [
    { "template": "home" },
    { "template": "ai" },
    { "template": "work" },
    { "template": "system" },
    { "template": "procs" },
    { "template": "deck" },
    { "template": "music" },
    { "template": "focus", "enabled": false },
    { "template": "world", "enabled": false }
  ],

  // Shortcut keys. The phone only sends the "id"; commands live in this file only.
  // cmd: a program, a URL / shell: / ms-settings: address, or builtin:lock | builtin:monitor-off | builtin:mute
  "shortcuts": [
    { "id": "terminal",   "label": "Terminal",     "icon": "\u2328\ufe0f", "color": "#4b5563", "cmd": "wt.exe" },
    { "id": "explorer",   "label": "Files",        "icon": "\ud83d\udcc1", "color": "#e5b84b", "cmd": "explorer.exe" },
    { "id": "vscode",     "label": "VS Code",      "icon": "\ud83d\udcdd", "color": "#2f80ed", "cmd": "shell:AppsFolder\\Microsoft.VisualStudioCode" },
    { "id": "browser",    "label": "Browser",      "icon": "\ud83c\udf10", "color": "#0ea5e9", "cmd": "https://github.com" },
    { "id": "spotify",    "label": "Spotify",      "icon": "\ud83c\udfa7", "color": "#1db954", "cmd": "shell:AppsFolder\\SpotifyAB.SpotifyMusic_zpdnekdrzrea0!Spotify" },
    { "id": "calc",       "label": "Calculator",   "icon": "\ud83e\uddee", "color": "#64748b", "cmd": "calc.exe" },
    { "id": "settings",   "label": "Settings",     "icon": "\u2699\ufe0f", "color": "#94a3b8", "cmd": "ms-settings:" },
    { "id": "snip",       "label": "Snip",         "icon": "\u2702\ufe0f", "color": "#14b8a6", "cmd": "ms-screenclip:" },
    { "id": "taskmgr",    "label": "Task Manager", "icon": "\ud83d\udcca", "color": "#22c55e", "cmd": "taskmgr.exe" },
    { "id": "mute",       "label": "Mute",         "icon": "\ud83d\udd07", "color": "#f59e0b", "cmd": "builtin:mute" },
    { "id": "monitoroff", "label": "Screen Off",   "icon": "\ud83c\udf19", "color": "#6366f1", "cmd": "builtin:monitor-off" },
    { "id": "lock",       "label": "Lock",         "icon": "\ud83d\udd12", "color": "#ef4444", "cmd": "builtin:lock" }
  ]
}
