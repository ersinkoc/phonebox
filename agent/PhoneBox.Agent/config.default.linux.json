{
  // PhoneBox settings. Easiest to edit at http://127.0.0.1:8765.
  // Manual edits are picked up on the next request; no restart needed.

  // Only use the phone with this serial number (null = every connected Android device)
  "deviceSerial": null,
  // Path to adb.exe (null = searched in PATH, the Android SDK and winget locations)
  "adbPath": null,

  // Weather location (Open-Meteo, no API key required) and the temperature unit: "celsius" or "fahrenheit"
  "weather": { "city": "Tallinn", "lat": 59.437, "lon": 24.745, "unit": "celsius", "model": "" },

  // Claude Code chats in the sessions widget. Both are off, because they come from your prompts: "shareSessionTitles" shows each
  // chat's title on the phone (without it only the folder name is shown and no title is read); "shareConversation" lets the phone
  // open a session's recent messages and steps (nothing is read from a chat file and nothing is sent). Windows: "watchWsl" also shows the sessions
  // of Claude Code inside the running WSL distros, and uses its sign-in there for the quota when Windows has none (off by default).
  "claude": { "shareSessionTitles": false, "shareConversation": false, "watchWsl": false },

  // Ping target for the ping metric and the "ping high" rule, every 5 s (empty = off)
  "ping": { "host": "1.1.1.1", "adapters": [] },
  // Discord widget: talks to the Discord desktop app on this computer. Create an application at discord.com/developers/applications, add the redirect http://127.0.0.1, and enter its client ID and secret (see docs/DISCORD.md). "allowControl" lets shortcuts and custom widgets mute, deafen, leave and join without a Discord widget (off by default). screenShare (off by default) lets the phone start and stop screen shares; it asks Discord for the rpc.screenshare scopes, so Discord asks you to approve PhoneBox again
  "discord": { "enabled": false, "clientId": null, "clientSecret": null, "allowControl": false, "screenShare": false, "chat": false },
  // Cursor agent chats on the AI sessions widget (off by default). Windows: "watchWsl" also reads the chats of projects opened over Remote - WSL, in the running distros (off by default). "phoneApprovals" sends the commands and MCP tool calls of the Cursor agent to the phone for Allow / Deny (needs the hook from Settings › General; off by default)
  "cursor": { "sessions": false, "watchWsl": false, "phoneApprovals": false },
  // Antigravity chats on the AI sessions widget (off by default)
  "antigravity": { "sessions": false, "shareSessionTitles": false },
  // Live Codex quotas read through the Codex CLI (off by default; Settings › General › AI quotas & CodexBar)
  "codexBar": { "codexLiveQuota": false },
  // OpenCode permission prompts on the phone: Allow (once or always) and Deny, read from OpenCode's
  // background service on 127.0.0.1. Off by default: set "phoneApprovals": true (or Settings › General) to let
  // the phone answer. "shareSessionTitles" puts the session titles on the phone too.
  "opencode": { "phoneApprovals": false, "sessions": false, "timeoutSec": 90, "alwaysCountdownSec": 10, "watchWsl": false, "shareSessionTitles": false },
  // App console widget (Windows): keys and dial bindings per app, matched by the focused window's process name
  "console": { "profiles": [] },
  // Phone mic (Windows, off by default): the phone's microphone played into a virtual cable ("endpoint", e.g. VB-CABLE's CABLE Input),
  // so apps pick the cable's other end as their microphone. Settings › General › Phone mic › Set up turns it on and fetches
  // scrcpy-server 5.0.1 from GitHub if it is missing ("serverPath": null = the copy next to this file)
  "phoneMic": { "enabled": false, "source": "mic-camcorder", "endpoint": "CABLE Input", "latencyMs": 50, "maxBufferMs": 150, "gain": 1, "serverPath": null, "startMuted": false },
  // Steam friends widget: enter your SteamID64 and a user Web API key in Settings › General (see docs/STEAM.md)
  "steam": { "enabled": false, "steamId": null, "apiKey": null },

  // Night mode: between these times the screen dims and only the clock stays. Tap to wake it for 30 s.
  "night": { "enabled": true, "start": "00:30", "end": "07:30", "brightness": 0.02 },

  // Clock seconds, return to the first page after N idle seconds (0 = never), vibrate on session events, a message when a session finishes,
  // switch pages with the phone's volume keys
  "display": { "showSeconds": true, "idleReturnSec": 90, "vibrate": true, "finishToast": true, "finishSound": false, "finishSoundVolume": 70, "volumeKeys": true, "pixelShift": false, "controlsTop": false, "pageBar": "dots", "pageBarSide": "bottom", "idleDimMin": 0, "nightWhenUnreachable": false, "unreachableNightDelayMin": 5, "wakeOnUnlock": false, "lockPhoneWithShortcut": false, "language": "auto", "wallpaper": { "dim": 45, "blur": 0 } },

  // Plex music control (Caldera Amp or another Plex Companion player): the server address and token, and the player address.
  // None of these go to the phone; the token is sent only to the server, never to the player.
  "controls": { "plexUrl": null, "plexToken": null, "plexPlayerUrl": "http://127.0.0.1:32500" },

  // Photo frame widget: "source" is "folder" or "immich". A folder source shows "folder" (empty = off) and whether subfolders count;
  // an Immich source shows one album ("immichAlbum" is its id) of the server at "immichUrl", read with the API key "immichKey". None of these go to the phone.
  "photos": { "source": "folder", "folder": "", "subfolders": true, "immichUrl": "", "immichKey": "", "immichAlbum": "", "immichAlbumName": "" },
  // IP cameras for the Camera widget: { "id", "name", "url": "rtsp://user:password@host:554/…", "transport": "tcp" | "udp", "fps": 1 to 10 (5) }.
  // "ffmpeg": its full path, or empty to find it in PATH. The addresses never go to the phone.
  "cameras": { "ffmpeg": "", "sources": [] },

  // Pages in the order they appear on the phone. Each page is a 12 x 6 grid of widgets; the settings page has a
  // visual editor. { "template": "<id>" } creates a page from templates.json (home, ai, work, system, procs, deck,
  // music, clock, focus, world, dashboard, devops, feeds, ambient, markets, daily, status, calm) and is replaced by
  // its widgets on the first save.
  "pages": [
    { "template": "home" },
    { "template": "ai" },
    { "template": "work" },
    { "template": "system" },
    { "template": "procs" },
    { "template": "deck" },
    { "template": "music" },
    { "template": "focus", "enabled": false },
    { "template": "world", "enabled": false }
  ],

  // Shortcut keys. The phone only sends the "id"; commands live in this file only.
  // cmd: a program, a URL, or builtin:lock | builtin:monitor-off | builtin:mute
  "shortcuts": [
    { "id": "terminal", "label": "Terminal", "icon": "\u2328\ufe0f", "color": "#4b5563", "cmd": "x-terminal-emulator" },
    { "id": "files", "label": "Files", "icon": "\ud83d\udcc1", "color": "#e5b84b", "cmd": "xdg-open", "args": "~" },
    { "id": "vscode", "label": "VS Code", "icon": "\ud83d\udcdd", "color": "#2f80ed", "cmd": "code" },
    { "id": "browser", "label": "Browser", "icon": "\ud83c\udf10", "color": "#0ea5e9", "cmd": "https://github.com" },
    { "id": "spotify", "label": "Spotify", "icon": "\ud83c\udfa7", "color": "#1db954", "cmd": "spotify" },
    { "id": "calc", "label": "Calculator", "icon": "\ud83e\uddee", "color": "#64748b", "cmd": "gnome-calculator" },
    { "id": "settings", "label": "Settings", "icon": "\u2699\ufe0f", "color": "#94a3b8", "cmd": "gnome-control-center" },
    { "id": "monitor", "label": "System Monitor", "icon": "\ud83d\udcca", "color": "#22c55e", "cmd": "gnome-system-monitor" },
    { "id": "mute", "label": "Mute", "icon": "\ud83d\udd07", "color": "#f59e0b", "cmd": "builtin:mute" },
    { "id": "monitoroff", "label": "Screen Off", "icon": "\ud83c\udf19", "color": "#6366f1", "cmd": "builtin:monitor-off" },
    { "id": "lock", "label": "Lock", "icon": "\ud83d\udd12", "color": "#ef4444", "cmd": "builtin:lock" }
  ]
}
